{
  "uid": "iyzitrace-trace-explorer",
  "title": "iyzitrace \u00b7 Trace Explorer",
  "description": "Hybrid trace dashboard. Time-series data uses Prometheus span_metrics (the metrics generator on Tempo isn't running locally). Trace search and service map use Tempo TraceQL directly. Click any trace ID to open the flame graph.",
  "tags": [
    "apm",
    "traces",
    "tempo",
    "iyzitrace",
    "traceql"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "DS_TEMPO",
        "label": "Tempo",
        "type": "datasource",
        "query": "tempo",
        "current": {
          "text": "Tempo (Observability Platform)",
          "value": "tempo-platform"
        },
        "hide": 0
      },
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus (Observability Platform)",
          "value": "prometheus-platform"
        },
        "hide": 2
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(iyzitrace_span_metrics_calls_total, service_name)",
          "refId": "A"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "slow_threshold",
        "label": "Slow threshold",
        "type": "custom",
        "query": "200ms,500ms,1s,2s,5s",
        "current": {
          "text": "500ms",
          "value": "500ms"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Pulse \u2014 rate, errors and latency straight from traces",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Span rate",
      "description": "Prometheus span_metrics rate() \u2014 spans/s derived directly from trace data.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "displayName": "spans/s",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(iyzitrace_span_metrics_calls_total{service_name=~\"${service:regex}\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error span rate",
      "description": "Prometheus span_metrics: spans with status=error per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "displayName": "errors/s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(iyzitrace_span_metrics_calls_total{service_name=~\"${service:regex}\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95 span duration",
      "description": "Prometheus span_metrics quantile_over_time(.95) \u2014 from actual trace data.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 200
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(iyzitrace_span_metrics_duration_milliseconds_bucket{service_name=~\"${service:regex}\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p99 span duration",
      "description": "Prometheus span_metrics quantile_over_time(.99) \u2014 from actual trace data.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1000
              },
              {
                "color": "red",
                "value": 5000
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(iyzitrace_span_metrics_duration_milliseconds_bucket{service_name=~\"${service:regex}\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "id": 200,
      "type": "row",
      "title": "Rate & latency over time \u2014 per service, from TraceQL",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Span rate by service",
      "description": "Prometheus span_metrics rate() by resource.service.name. Counting actual spans in Tempo \u2014 no pre-aggregation.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(iyzitrace_span_metrics_calls_total{service_name=~\"${service:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Error span rate by service",
      "description": "Prometheus span_metrics: status=error spans grouped by service.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(iyzitrace_span_metrics_calls_total{service_name=~\"${service:regex}\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "p95 duration by service",
      "description": "Prometheus span_metrics quantile_over_time(.95) grouped by service \u2014 latency from actual spans.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (service_name, le) (rate(iyzitrace_span_metrics_duration_milliseconds_bucket{service_name=~\"${service:regex}\"}[$__rate_interval])))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 300,
      "type": "row",
      "title": "Trace feed \u2014 click any row to open the full flame graph",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      }
    },
    {
      "id": 20,
      "type": "traces",
      "title": "Recent traces",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "options": {
        "frameType": "TRACE_LIST"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name =~ \"${service:regex}\"}",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 400,
      "type": "row",
      "title": "Targeted searches",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      }
    },
    {
      "id": 30,
      "type": "traces",
      "title": "Error traces  {status = error}",
      "description": "Spans with an explicit error status. Your incident starting point.",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "options": {
        "frameType": "TRACE_LIST"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name =~ \"${service:regex}\" && status = error}",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 31,
      "type": "traces",
      "title": "Slow traces  {duration > $slow_threshold}",
      "description": "Spans whose duration exceeds the variable threshold.",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "options": {
        "frameType": "TRACE_LIST"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name =~ \"${service:regex}\" && duration > $slow_threshold}",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 500,
      "type": "row",
      "title": "Attribute deep-dives \u2014 things only trace data can tell you",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 39
      }
    },
    {
      "id": 40,
      "type": "traces",
      "title": "Database call traces  {span.db.system != \"\"}",
      "description": "Traces touching a DB. Instantly find slow queries by clicking the trace and inspecting the DB span.",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "options": {
        "frameType": "TRACE_LIST"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name =~ \"${service:regex}\" && span.db.system != \"\"}",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 41,
      "type": "traces",
      "title": "HTTP 4xx / 5xx traces  {span.http.status_code >= 400}",
      "description": "Catches HTTP-level errors that may not set span status=error \u2014 pure trace attribute query.",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "options": {
        "frameType": "TRACE_LIST"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name =~ \"${service:regex}\" && span.http.status_code >= 400}",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 42,
      "type": "traces",
      "title": "Slow DB calls  {span.db.system != \"\" && duration > 200ms}",
      "description": "Pinpoints exactly which DB operations are slow \u2014 impossible to identify from metrics alone.",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 51
      },
      "options": {
        "frameType": "TRACE_LIST"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name =~ \"${service:regex}\" && span.db.system != \"\" && duration > 200ms}",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 43,
      "type": "traces",
      "title": "Root-cause errors  {status = error && parent.status != error}",
      "description": "Error spans whose parent span is NOT an error \u2014 these are the origin of the fault, not cascading failures. Pure signal.",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 12,
        "y": 51
      },
      "options": {
        "frameType": "TRACE_LIST"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name =~ \"${service:regex}\" && status = error && parent.status != error}",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 600,
      "type": "row",
      "title": "Live service map from Tempo",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 62
      }
    },
    {
      "id": 50,
      "type": "nodeGraph",
      "title": "Service map \u2014 live from Tempo trace propagation",
      "description": "Built from actual trace context propagation \u2014 not metric aliases. Node size = request rate, edge colour = error rate.",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 63
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "nodes": {
          "mainStatUnit": "r/min"
        },
        "edges": {
          "mainStatUnit": "r/min"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "serviceMap",
          "serviceMapQuery": ""
        }
      ]
    }
  ]
}