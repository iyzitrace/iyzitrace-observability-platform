{
  "uid": "iyzitrace-signal-correlator",
  "title": "iyzitrace \u00b7 Telemetry Signal Correlator",
  "description": "Three telemetry signals \u2014 metric, trace, log \u2014 for the same services side-by-side. Spot a service where one signal drops while the others stay steady (silent telemetry loss). Tempo's metrics-generator isn't running here, so the middle column uses span_metrics (which are derived from traces upstream) \u2014 same shape, different transport.",
  "tags": [
    "platform",
    "telemetry",
    "correlation",
    "iyzitrace"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus (Observability Platform)",
          "value": "prometheus-platform"
        },
        "hide": 0
      },
      {
        "name": "DS_TEMPO",
        "label": "Tempo",
        "type": "datasource",
        "query": "tempo",
        "current": {
          "text": "Tempo (Observability Platform)",
          "value": "tempo-platform"
        },
        "hide": 0
      },
      {
        "name": "DS_LOKI",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {
          "text": "Loki (Observability Platform)",
          "value": "loki-platform"
        },
        "hide": 0
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(iyzitrace_span_metrics_calls_total, service_name)",
          "refId": "A"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Three signals \u2014 same time window",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Metric series \u2014 span calls / sec (Prometheus)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(iyzitrace_span_metrics_calls_total{service_name=~\"${service:regex}\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Spans / sec (from span_metrics)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(iyzitrace_span_metrics_calls_total{service_name=~\"${service:regex}\"}[$__rate_interval]))"
        }
      ],
      "description": "Source: iyzitrace_span_metrics_calls_total \u2014 span counts pre-aggregated to Prometheus by the OTel pipeline."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Log lines / sec (Loki)",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "lps",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum(rate({service_name=~\"${service:regex}\"}[$__rate_interval]))",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 200,
      "type": "row",
      "title": "Time-aligned signal traces",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Metric: span calls / sec by service (Prometheus)",
      "description": "Source: iyzitrace_span_metrics_calls_total. Aggregated from spans by the OTel span-to-metric processor.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(iyzitrace_span_metrics_calls_total{service_name=~\"${service:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Spans / sec by service (from span_metrics)",
      "description": "Per-service span rate from span_metrics. Should track #1 closely if both pipelines are healthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(iyzitrace_span_metrics_calls_total{service_name=~\"${service:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Logs: lines / sec by service (Loki)",
      "description": "Source: Loki rate(). Different services log at very different volumes \u2014 what matters is the slope, not the absolute value.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "lps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum by (service_name) (rate({service_name=~\"${service:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 300,
      "type": "row",
      "title": "Coverage matrix \u2014 which services emit which signals?",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      }
    },
    {
      "id": 20,
      "type": "table",
      "title": "Per-service signal coverage",
      "description": "For each service: are we receiving metrics, traces, and logs right now? Empty cells = pipeline gap.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Spans/min (metric)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.001
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Errors/min"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.1
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95 (ms)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Lang"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text",
                  "mode": "gradient"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Spans/min (metric)",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name, telemetry_sdk_language) (rate(iyzitrace_span_metrics_calls_total{service_name=~\"${service:regex}\"}[$__rate_interval])) * 60",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto"
        },
        {
          "refId": "B",
          "expr": "sum by (service_name) (rate(iyzitrace_span_metrics_calls_total{service_name=~\"${service:regex}\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) * 60",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum by (service_name, le) (rate(iyzitrace_span_metrics_duration_milliseconds_bucket{service_name=~\"${service:regex}\"}[$__rate_interval])))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "indexByName": {
              "service_name": 0,
              "telemetry_sdk_language": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4
            },
            "renameByName": {
              "service_name": "Service",
              "telemetry_sdk_language": "Lang",
              "Value #A": "Spans/min (metric)",
              "Value #B": "Errors/min",
              "Value #C": "p95 (ms)"
            }
          }
        }
      ]
    },
    {
      "id": 400,
      "type": "row",
      "title": "Service log feed (filtered to selection)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 30
      }
    },
    {
      "id": 30,
      "type": "logs",
      "title": "Recent logs",
      "description": "Logs from the selected services \u2014 newest first. Trace_id chips link to the corresponding trace in Tempo.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "{service_name=~\"${service:regex}\"}",
          "queryType": "range"
        }
      ]
    }
  ]
}