{
  "uid": "iyzitrace-log-intelligence",
  "title": "iyzitrace · Log Intelligence",
  "description": "Loki-driven log analytics: volume, severity mix, service health timeline, error patterns, and Envoy HTTP access logs. Every panel is LogQL — no Prometheus involved.",
  "tags": ["loki", "logs", "iyzitrace", "infrastructure"],
  "schemaVersion": 39, "version": 1, "editable": true, "graphTooltip": 1,
  "timezone": "browser", "time": {"from": "now-1h", "to": "now"}, "refresh": "30s",
  "annotations": {"list": []},
  "templating": {"list": [
    {"name": "DS_LOKI", "label": "Loki", "type": "datasource", "query": "loki", "current": {"text": "Loki (Observability Platform)", "value": "loki-platform"}, "hide": 0},
    {"name": "service", "label": "Service", "type": "query", "datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "query": "label_values(service_name)", "refresh": 2, "sort": 1, "multi": true, "includeAll": true, "allValue": ".+", "current": {"text": "All", "value": "$__all"}}
  ]},
  "panels": [
    {"id": 100, "type": "row", "title": "Log pulse", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}},

    {"id": 1, "type": "stat", "title": "Active log streams",
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "blue"}}},
      "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "expr": "count(sum by (service_name) (rate({service_name=~\"${service:regex}\"}[$__rate_interval])))", "queryType": "range"}]
    },
    {"id": 2, "type": "stat", "title": "Log lines / sec",
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "lps", "decimals": 1, "color": {"mode": "fixed", "fixedColor": "green"}}},
      "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "expr": "sum(rate({service_name=~\"${service:regex}\"}[$__rate_interval]))", "queryType": "range"}]
    },
    {"id": 3, "type": "stat", "title": "Error lines / sec",
      "description": "detected_level = ERROR or severity_text = ERROR.",
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "lps", "decimals": 2, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.1}, {"color": "orange", "value": 1}, {"color": "red", "value": 10}]}}},
      "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "expr": "sum(rate({service_name=~\"${service:regex}\"} | detected_level=~\"(?i)error\"[$__rate_interval]))", "queryType": "range"}]
    },
    {"id": 4, "type": "stat", "title": "Warn lines / sec",
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "lps", "decimals": 2, "color": {"mode": "fixed", "fixedColor": "orange"}}},
      "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "expr": "sum(rate({service_name=~\"${service:regex}\"} | detected_level=~\"(?i)warn\"[$__rate_interval]))", "queryType": "range"}]
    },

    {"id": 200, "type": "row", "title": "Volume & severity over time", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}},

    {"id": 10, "type": "timeseries", "title": "Log volume by service",
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 6},
      "fieldConfig": {"defaults": {"unit": "lps", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 30, "stacking": {"mode": "normal", "group": "A"}}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "expr": "sum by (service_name) (rate({service_name=~\"${service:regex}\"}[$__rate_interval]))", "legendFormat": "{{service_name}}", "queryType": "range"}]
    },
    {"id": 11, "type": "timeseries", "title": "Log volume by severity (stacked)",
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 6},
      "fieldConfig": {"defaults": {"unit": "lps", "custom": {"drawStyle": "bars", "lineWidth": 0, "fillOpacity": 80, "stacking": {"mode": "normal", "group": "A"}}}, "overrides": [
        {"matcher": {"id": "byRegexp", "options": "(?i)error"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#E02F44"}}]},
        {"matcher": {"id": "byRegexp", "options": "(?i)warn"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#FF9830"}}]},
        {"matcher": {"id": "byRegexp", "options": "(?i)info"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#73BF69"}}]},
        {"matcher": {"id": "byRegexp", "options": "(?i)debug"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#5794F2"}}]},
        {"matcher": {"id": "byRegexp", "options": "(?i)unknown"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#8E8E8E"}}]}
      ]},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "expr": "sum by (detected_level) (rate({service_name=~\"${service:regex}\"} | detected_level != \"\" [$__rate_interval]))", "legendFormat": "{{detected_level}}", "queryType": "range"}]
    },

    {"id": 300, "type": "row", "title": "Service health timeline", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 15}},

    {"id": 20, "type": "status-history", "title": "Error log share per service over time",
      "description": "Each row = a service. Cell colour = error log share at that bucket. Green = healthy, red = bad. Spot regressions across services at a glance.",
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 16},
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 2, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.01}, {"color": "orange", "value": 0.05}, {"color": "red", "value": 0.1}]}, "custom": {"lineWidth": 1, "fillOpacity": 90, "spanNulls": false}}},
      "options": {"mergeValues": false, "showValue": "never", "rowHeight": 0.85, "legend": {"showLegend": false}, "tooltip": {"mode": "single"}},
      "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "expr": "sum by (service_name) (rate({service_name=~\"${service:regex}\"} | detected_level=~\"(?i)error\"[$__interval])) / clamp_min(sum by (service_name) (rate({service_name=~\"${service:regex}\"}[$__interval])), 1e-9)", "legendFormat": "{{service_name}}", "queryType": "range"}]
    },

    {"id": 400, "type": "row", "title": "Live error feed", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 28}},

    {"id": 30, "type": "logs", "title": "Errors & warnings — newest first",
      "description": "All ERROR and WARN log lines, structured metadata visible. Click trace_id chips to jump to the trace.",
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "gridPos": {"h": 14, "w": 24, "x": 0, "y": 29},
      "options": {"showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "expr": "{service_name=~\"${service:regex}\"} | detected_level=~\"(?i)(error|warn)\"", "queryType": "range"}]
    },

    {"id": 500, "type": "row", "title": "Envoy HTTP access logs (frontend-proxy)", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 43}},

    {"id": 40, "type": "timeseries", "title": "HTTP request rate (by upstream cluster)",
      "description": "Counted from Envoy access log lines emitted by frontend-proxy. Each line = one HTTP request handled by the proxy.",
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 44},
      "fieldConfig": {"defaults": {"unit": "reqps", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "stacking": {"mode": "normal", "group": "A"}}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "expr": "sum by (upstream_cluster) (rate({service_name=\"frontend-proxy\"} | event_name=\"proxy.access\"[$__rate_interval]))", "legendFormat": "{{upstream_cluster}}", "queryType": "range"}]
    },
    {"id": 41, "type": "table", "title": "Top URL paths",
      "description": "Most-requested paths through the proxy in the current range.",
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 44},
      "fieldConfig": {"defaults": {"custom": {"align": "auto"}}, "overrides": [
        {"matcher": {"id": "byName", "options": "Value"}, "properties": [{"id": "unit", "value": "short"}, {"id": "decimals", "value": 0}, {"id": "displayName", "value": "Requests"}, {"id": "custom.cellOptions", "value": {"type": "gauge", "mode": "gradient"}}]}
      ]},
      "options": {"showHeader": true, "footer": {"show": false}, "sortBy": [{"displayName": "Requests", "desc": true}]},
      "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "expr": "topk(15, sum by (url_path) (count_over_time({service_name=\"frontend-proxy\"} | event_name=\"proxy.access\" [$__range])))", "queryType": "instant", "format": "table", "instant": true}],
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true}, "renameByName": {"url_path": "URL Path"}}}]
    },
    {"id": 42, "type": "table", "title": "Top user agents",
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 53},
      "fieldConfig": {"defaults": {"custom": {"align": "auto"}}, "overrides": [
        {"matcher": {"id": "byName", "options": "Value"}, "properties": [{"id": "unit", "value": "short"}, {"id": "decimals", "value": 0}, {"id": "displayName", "value": "Requests"}, {"id": "custom.cellOptions", "value": {"type": "gauge", "mode": "gradient"}}]}
      ]},
      "options": {"showHeader": true, "footer": {"show": false}, "sortBy": [{"displayName": "Requests", "desc": true}]},
      "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "expr": "topk(10, sum by (user_agent_original) (count_over_time({service_name=\"frontend-proxy\"} | event_name=\"proxy.access\" [$__range])))", "queryType": "instant", "format": "table", "instant": true}],
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true}, "renameByName": {"user_agent_original": "User-Agent"}}}]
    },
    {"id": 43, "type": "table", "title": "Top source IPs",
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 53},
      "fieldConfig": {"defaults": {"custom": {"align": "auto"}}, "overrides": [
        {"matcher": {"id": "byName", "options": "Value"}, "properties": [{"id": "unit", "value": "short"}, {"id": "decimals", "value": 0}, {"id": "displayName", "value": "Requests"}, {"id": "custom.cellOptions", "value": {"type": "gauge", "mode": "gradient"}}]}
      ]},
      "options": {"showHeader": true, "footer": {"show": false}, "sortBy": [{"displayName": "Requests", "desc": true}]},
      "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "expr": "topk(15, sum by (source_address) (count_over_time({service_name=\"frontend-proxy\"} | event_name=\"proxy.access\" [$__range])))", "queryType": "instant", "format": "table", "instant": true}],
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true}, "renameByName": {"source_address": "Source IP"}}}]
    },

    {"id": 600, "type": "row", "title": "Trace correlation hygiene", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 62}},

    {"id": 50, "type": "timeseries", "title": "Logs with trace context — coverage %",
      "description": "Share of log lines that carry a trace_id. High = good correlation. If this drops, traces and logs are diverging — investigate before a debug session bites you.",
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 63},
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 2, "min": 0, "max": 1, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0.3}, {"color": "yellow", "value": 0.6}, {"color": "green", "value": 0.8}]}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 25, "thresholdsStyle": {"mode": "dashed"}}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "min"]}, "tooltip": {"mode": "multi"}},
      "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "expr": "sum by (service_name) (rate({service_name=~\"${service:regex}\"} | trace_id != \"\" [$__rate_interval])) / clamp_min(sum by (service_name) (rate({service_name=~\"${service:regex}\"}[$__rate_interval])), 1e-9)", "legendFormat": "{{service_name}}", "queryType": "range"}]
    },
    {"id": 51, "type": "timeseries", "title": "Log volume by SDK language",
      "description": "Cross-runtime log volume. Useful for capacity planning by language.",
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 63},
      "fieldConfig": {"defaults": {"unit": "lps", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 25, "stacking": {"mode": "normal", "group": "A"}}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "expr": "sum by (telemetry_sdk_language) (rate({service_name=~\"${service:regex}\"} | telemetry_sdk_language != \"\" [$__rate_interval]))", "legendFormat": "{{telemetry_sdk_language}}", "queryType": "range"}]
    }
  ]
}
