      "targets": [
        {
          "expr": "rate(redis_keys_evicted_total{instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "Evicted/s",
          "refId": "A"
        },
        {
          "expr": "rate(redis_keys_expired_total{instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "Expired/s",
          "refId": "B"
        }
      ],
      "title": "Key Eviction & Expiry Rate",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 20,
      "panels": [],
      "title": "Performance",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Commands processed per second derived from the redis_commands_processed_total counter. This is the single most important performance indicator — it shows how hard Redis is working. Correlate drops with client-side errors or latency spikes.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "#5794F2",
            "mode": "fixed"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "id": 21,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(redis_commands_processed_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "Ops/s",
          "refId": "A"
        }
      ],
      "title": "Command Throughput (Ops/s)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Hit rate = hits / (hits + misses) × 100. Color bands reflect operational health:\n• Green (≥95 %) — target zone.\n• Yellow (80–95 %) — degraded; investigate key patterns.\n• Red (<80 %) — cache is largely ineffective; application is hammering the backend.\nA sudden drop without a change in ops/s indicates keys have expired or been evicted.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "thresholdsStyle": {
              "mode": "area"
            }
          },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
