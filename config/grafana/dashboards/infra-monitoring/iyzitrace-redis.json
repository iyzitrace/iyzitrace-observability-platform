            "matcher": {
              "id": "byName",
              "options": "Used"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#5794F2",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 6
      },
      "id": 11,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "12.2.0",
      "targets": [
        {
          "expr": "redis_memory_used_bytes{instance=~\"$instance\"}",
          "legendFormat": "Used",
          "refId": "A"
        },
        {
          "expr": "redis_memory_peak_bytes{instance=~\"$instance\"}",
          "legendFormat": "Peak",
          "refId": "B"
        },
        {
          "expr": "redis_memory_rss_bytes{instance=~\"$instance\"}",
          "legendFormat": "RSS",
          "refId": "C"
        }
      ],
      "title": "Memory Usage — Used vs Peak vs RSS",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "RSS / used_memory. Ideal range: 1.0 – 1.5.\n• < 1.0 — Redis is using swap (very dangerous, extreme latency).\n• 1.0–1.5 — healthy.\n• 1.5–2.0 — elevated; consider enabling activedefrag.\n• > 2.0 — critical; plan a rolling restart.",
      "fieldConfig": {
