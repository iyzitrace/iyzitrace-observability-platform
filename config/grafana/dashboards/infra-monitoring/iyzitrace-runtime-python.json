{
  "uid": "iyzitrace-runtime-python",
  "title": "iyzitrace · Python (CPython) Runtime",
  "description": "OpenTelemetry Python runtime: generational GC, RSS/VMS memory, GIL CPU utilization, threads, context switches. Auto-discovers Python services via telemetry_sdk_language=\"python\".",
  "tags": ["runtime", "python", "cpython", "iyzitrace", "infrastructure"],
  "schemaVersion": 39, "version": 1, "editable": true, "graphTooltip": 1,
  "timezone": "browser", "time": {"from": "now-1h", "to": "now"}, "refresh": "30s",
  "annotations": {"list": []},
  "templating": {"list": [
    {"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "query": "prometheus", "current": {"text": "Prometheus (Observability Platform)", "value": "prometheus-platform"}, "hide": 0},
    {"name": "service", "label": "Service", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": {"qryType": 1, "query": "label_values(process_runtime_cpython_memory_bytes, service_name)", "refId": "A"}, "refresh": 2, "sort": 1, "multi": true, "includeAll": true, "allValue": ".+", "current": {"text": "All", "value": "$__all"}}
  ]},
  "panels": [
    {"id": 100, "type": "row", "title": "Process pulse", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}},

    {"id": 1, "type": "stat", "title": "Active Python processes",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "blue"}}},
      "targets": [{"refId": "A", "expr": "count(process_runtime_cpython_thread_count{service_name=~\"${service:regex}\"})"}]
    },
    {"id": 2, "type": "stat", "title": "Python version",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 4, "w": 5, "x": 4, "y": 1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "none", "graphMode": "none", "textMode": "name"},
      "fieldConfig": {"defaults": {"unit": "none", "color": {"mode": "fixed", "fixedColor": "purple"}}},
      "targets": [{"refId": "A", "expr": "max by (telemetry_auto_version) (process_runtime_cpython_thread_count{service_name=~\"${service:regex}\"})", "legendFormat": "OTel auto {{telemetry_auto_version}}"}]
    },
    {"id": 3, "type": "stat", "title": "Resident memory (RSS)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 4, "w": 5, "x": 9, "y": 1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "bytes", "decimals": 1, "color": {"mode": "fixed", "fixedColor": "yellow"}}},
      "targets": [{"refId": "A", "expr": "sum(process_runtime_cpython_memory_bytes{service_name=~\"${service:regex}\", type=\"rss\"})"}]
    },
    {"id": 4, "type": "stat", "title": "CPU utilization",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 4, "w": 5, "x": 14, "y": 1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 2, "min": 0, "max": 1, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.5}, {"color": "orange", "value": 0.8}, {"color": "red", "value": 0.95}]}}},
      "targets": [{"refId": "A", "expr": "avg(process_runtime_cpython_cpu_utilization_ratio{service_name=~\"${service:regex}\"})"}]
    },
    {"id": 5, "type": "stat", "title": "Threads",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 4, "w": 5, "x": 19, "y": 1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "green"}}},
      "targets": [{"refId": "A", "expr": "sum(process_runtime_cpython_thread_count{service_name=~\"${service:regex}\"})"}]
    },

    {"id": 200, "type": "row", "title": "Memory", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}},

    {"id": 10, "type": "timeseries", "title": "RSS vs VMS per service",
      "description": "RSS = resident set (physical RAM). VMS = virtual address space. Big VMS-RSS gap = lots of mmap'd / reserved-but-not-faulted pages.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 6},
      "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}}, "overrides": [
        {"matcher": {"id": "byRegexp", "options": "rss.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#73BF69"}}]},
        {"matcher": {"id": "byRegexp", "options": "vms.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#5794F2"}}]}
      ]},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "A", "expr": "sum by (service_name) (process_runtime_cpython_memory_bytes{service_name=~\"${service:regex}\", type=\"rss\"})", "legendFormat": "rss · {{service_name}}"},
        {"refId": "B", "expr": "sum by (service_name) (process_runtime_cpython_memory_bytes{service_name=~\"${service:regex}\", type=\"vms\"})", "legendFormat": "vms · {{service_name}}"}
      ]
    },
    {"id": 11, "type": "timeseries", "title": "RSS growth — leak detector",
      "description": "Steady-state RSS should plateau. Continuous growth across many GC cycles ⇒ probable leak.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 6},
      "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 25}, "color": {"mode": "palette-classic"}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max", "delta"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (service_name) (process_runtime_cpython_memory_bytes{service_name=~\"${service:regex}\", type=\"rss\"})", "legendFormat": "{{service_name}}"}]
    },

    {"id": 300, "type": "row", "title": "Garbage collection (generational)", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 15}},

    {"id": 20, "type": "timeseries", "title": "GC frequency by generation",
      "description": "Python's generational GC: gen0 churns most often, gen2 collections are rare and expensive.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 16},
      "fieldConfig": {"defaults": {"unit": "cps", "custom": {"drawStyle": "bars", "lineWidth": 0, "fillOpacity": 80, "stacking": {"mode": "normal", "group": "A"}}}, "overrides": [
        {"matcher": {"id": "byName", "options": "0"}, "properties": [{"id": "displayName", "value": "gen0"}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "#8AB8FF"}}]},
        {"matcher": {"id": "byName", "options": "1"}, "properties": [{"id": "displayName", "value": "gen1"}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "#FF9830"}}]},
        {"matcher": {"id": "byName", "options": "2"}, "properties": [{"id": "displayName", "value": "gen2"}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "#E02F44"}}]}
      ]},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["sum", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (generation) (rate(cpython_gc_collections_total{service_name=~\"${service:regex}\"}[$__rate_interval]))", "legendFormat": "{{generation}}"}]
    },
    {"id": 21, "type": "timeseries", "title": "Objects collected per second by generation",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 16},
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15}}, "overrides": [
        {"matcher": {"id": "byName", "options": "0"}, "properties": [{"id": "displayName", "value": "gen0"}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "#8AB8FF"}}]},
        {"matcher": {"id": "byName", "options": "1"}, "properties": [{"id": "displayName", "value": "gen1"}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "#FF9830"}}]},
        {"matcher": {"id": "byName", "options": "2"}, "properties": [{"id": "displayName", "value": "gen2"}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "#E02F44"}}]}
      ]},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (generation) (rate(cpython_gc_collected_objects_total{service_name=~\"${service:regex}\"}[$__rate_interval]))", "legendFormat": "{{generation}}"}]
    },
    {"id": 22, "type": "timeseries", "title": "Uncollectable objects — circular reference leaks",
      "description": "Non-zero rate = objects with __del__ involved in cycles. These are pure leaks Python's GC can't reclaim.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 25},
      "fieldConfig": {"defaults": {"unit": "ops", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.001}, {"color": "red", "value": 0.1}]}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 25, "thresholdsStyle": {"mode": "dashed"}}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["sum", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [{"refId": "A", "expr": "sum by (service_name, generation) (rate(cpython_gc_uncollectable_objects_total{service_name=~\"${service:regex}\"}[$__rate_interval]))", "legendFormat": "{{service_name}} · gen{{generation}}"}]
    },

    {"id": 400, "type": "row", "title": "CPU & concurrency", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 33}},

    {"id": 30, "type": "timeseries", "title": "CPU utilization per service",
      "description": "GIL-bound — single-threaded CPython tops out near 1.0 per process even with many threads.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 34},
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 2, "min": 0, "max": 1, "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "avg by (service_name) (process_runtime_cpython_cpu_utilization_ratio{service_name=~\"${service:regex}\"})", "legendFormat": "{{service_name}}"}]
    },
    {"id": 31, "type": "timeseries", "title": "CPU time / sec",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 34},
      "fieldConfig": {"defaults": {"unit": "s", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean"]}, "tooltip": {"mode": "multi"}},
      "targets": [{"refId": "A", "expr": "sum by (service_name) (rate(process_runtime_cpython_cpu_time_seconds_total{service_name=~\"${service:regex}\"}[$__rate_interval]))", "legendFormat": "{{service_name}}"}]
    },
    {"id": 32, "type": "timeseries", "title": "Threads per service",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 42},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [{"refId": "A", "expr": "sum by (service_name) (process_runtime_cpython_thread_count{service_name=~\"${service:regex}\"})", "legendFormat": "{{service_name}}"}]
    },
    {"id": 33, "type": "timeseries", "title": "Context switches / sec",
      "description": "High involuntary context switching = CPU contention or GIL fighting between threads.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 42},
      "fieldConfig": {"defaults": {"unit": "ops", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (service_name) (rate(process_runtime_cpython_context_switches_total{service_name=~\"${service:regex}\"}[$__rate_interval]))", "legendFormat": "{{service_name}}"}]
    }
  ]
}
