          "hideZeros": false,
          "mode": "single",
          "sort": "none"
        }
      },
      "pluginVersion": "12.2.0",
      "targets": [
        {
          "expr": "postgresql_db_size_bytes{host_name=~\"$host\",postgresql_database_name=~\"$db\"}",
          "legendFormat": "{{postgresql_database_name}}",
          "refId": "A"
        }
      ],
      "title": "Database Size Distribution",
      "type": "piechart"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Current table sizes ranked from largest to smallest. Identify the biggest consumers of disk space at a glance. Tables growing faster than expected may be missing a vacuum or have bloated dead rows.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": 0
              },
              {
                "color": "green",
                "value": 1048576
              },
              {
                "color": "yellow",
                "value": 10485760
              },
              {
                "color": "orange",
                "value": 104857600
              }
            ]
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "id": 9,
