        {
          "expr": "sort_desc(postgresql_table_size_bytes{host_name=~\"$host\",postgresql_database_name=~\"$db\"})",
          "legendFormat": "{{postgresql_table_name}}",
          "refId": "A"
        }
      ],
      "title": "Table Sizes",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Cache hit rate: shared_buffers hits vs disk reads. 99 %+ is the production target. Falling below 95 % means Postgres is reading from disk — increase shared_buffers or investigate sequential scans.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1,
          "mappings": [],
          "max": 100,
          "min": 0,
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "yellow",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 4,
        "y": 4
      },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.2.0",
      "targets": [
        {
          "expr": "100 * sum(rate(postgresql_blks_hit_total{host_name=~\"$host\"}[5m])) / (sum(rate(postgresql_blks_hit_total{host_name=~\"$host\"}[5m])) + sum(rate(postgresql_blks_read_total{host_name=~\"$host\"}[5m])))",
          "legendFormat": "Hit Rate",
          "refId": "A"
        }
      ],
      "title": "Cache Hit Rate",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Total rollbacks since startup. Occasional rollbacks are normal (constraint violations, explicit ROLLBACK). A high or rising rollback-to-commit ratio signals application logic errors.",
