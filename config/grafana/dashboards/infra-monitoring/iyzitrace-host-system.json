{
  "uid": "iyzitrace-host-system",
  "title": "iyzitrace · Host System Health",
  "description": "OpenTelemetry hostmetrics: CPU, load, memory, disk I/O, filesystem usage, network, paging, processes. Per-host view of the underlying machines that host the application services.",
  "tags": ["host", "system", "infrastructure", "iyzitrace"],
  "schemaVersion": 39, "version": 1, "editable": true, "graphTooltip": 1,
  "timezone": "browser", "time": {"from": "now-1h", "to": "now"}, "refresh": "30s",
  "annotations": {"list": []},
  "templating": {"list": [
    {"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "query": "prometheus", "current": {"text": "Prometheus (Observability Platform)", "value": "prometheus-platform"}, "hide": 0},
    {"name": "host", "label": "Host", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": {"qryType": 1, "query": "label_values(system_uptime_seconds, host_name)", "refId": "A"}, "refresh": 2, "sort": 1, "multi": true, "includeAll": true, "allValue": ".+", "current": {"text": "All", "value": "$__all"}}
  ]},
  "panels": [
    {"id": 100, "type": "row", "title": "Host pulse", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}},

    {"id": 1, "type": "stat", "title": "Hosts",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "blue"}}},
      "targets": [{"refId": "A", "expr": "count(system_uptime_seconds{host_name=~\"${host:regex}\"})"}]
    },
    {"id": 2, "type": "stat", "title": "CPU utilization (avg)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 2, "min": 0, "max": 1, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.5}, {"color": "orange", "value": 0.8}, {"color": "red", "value": 0.95}]}}},
      "targets": [{"refId": "A", "expr": "avg(1 - sum by (host_name) (rate(system_cpu_time_seconds_total{host_name=~\"${host:regex}\", state=\"idle\"}[$__rate_interval])) / clamp_min(sum by (host_name) (rate(system_cpu_time_seconds_total{host_name=~\"${host:regex}\"}[$__rate_interval])), 1e-9))"}]
    },
    {"id": 3, "type": "stat", "title": "Load 1m (max)",
      "description": "Highest 1-minute load average across selected hosts. > number of cores = saturated.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 2, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 2}, {"color": "red", "value": 8}]}}},
      "targets": [{"refId": "A", "expr": "max(system_cpu_load_average_1m{host_name=~\"${host:regex}\"})"}]
    },
    {"id": 4, "type": "stat", "title": "Memory used (max %)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 2, "min": 0, "max": 1, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.7}, {"color": "orange", "value": 0.85}, {"color": "red", "value": 0.95}]}}},
      "targets": [{"refId": "A", "expr": "max(system_memory_utilization_ratio{host_name=~\"${host:regex}\", state=\"used\"})"}]
    },
    {"id": 5, "type": "stat", "title": "Disk used (max %)",
      "description": "Highest filesystem usage across mountpoints.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 2, "min": 0, "max": 1, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.7}, {"color": "orange", "value": 0.85}, {"color": "red", "value": 0.95}]}}},
      "targets": [{"refId": "A", "expr": "max(sum by (host_name, mountpoint) (system_filesystem_usage_bytes{host_name=~\"${host:regex}\", state=\"used\"}) / clamp_min(sum by (host_name, mountpoint) (system_filesystem_usage_bytes{host_name=~\"${host:regex}\", state=~\"used|free\"}), 1))"}]
    },
    {"id": 6, "type": "stat", "title": "Uptime (oldest)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"},
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "green"}}},
      "targets": [{"refId": "A", "expr": "max(system_uptime_seconds{host_name=~\"${host:regex}\"})"}]
    },

    {"id": 200, "type": "row", "title": "CPU", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}},

    {"id": 10, "type": "timeseries", "title": "CPU utilization per host",
      "description": "1 - idle. Sustained > 0.8 = host CPU-bound.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 6},
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 2, "min": 0, "max": 1, "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "1 - sum by (host_name) (rate(system_cpu_time_seconds_total{host_name=~\"${host:regex}\", state=\"idle\"}[$__rate_interval])) / clamp_min(sum by (host_name) (rate(system_cpu_time_seconds_total{host_name=~\"${host:regex}\"}[$__rate_interval])), 1e-9)", "legendFormat": "{{host_name}}"}]
    },
    {"id": 11, "type": "timeseries", "title": "CPU time by state (stacked)",
      "description": "Where the CPU time goes: user (your code) / system (kernel) / iowait (waiting on disk) / steal (hypervisor stealing) / idle.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 6},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"drawStyle": "line", "lineWidth": 0, "fillOpacity": 90, "stacking": {"mode": "normal", "group": "A"}}}, "overrides": [
        {"matcher": {"id": "byName", "options": "user"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#5794F2"}}]},
        {"matcher": {"id": "byName", "options": "system"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#FF9830"}}]},
        {"matcher": {"id": "byName", "options": "wait"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#E02F44"}}]},
        {"matcher": {"id": "byName", "options": "idle"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#37872D"}}]},
        {"matcher": {"id": "byName", "options": "steal"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#B877D9"}}]},
        {"matcher": {"id": "byName", "options": "irq"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#F2CC0C"}}]},
        {"matcher": {"id": "byName", "options": "softirq"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#FA6400"}}]},
        {"matcher": {"id": "byName", "options": "nice"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#73BF69"}}]}
      ]},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (state) (rate(system_cpu_time_seconds_total{host_name=~\"${host:regex}\"}[$__rate_interval])) / clamp_min(scalar(sum(rate(system_cpu_time_seconds_total{host_name=~\"${host:regex}\"}[$__rate_interval]))), 1e-9)", "legendFormat": "{{state}}"}]
    },
    {"id": 12, "type": "timeseries", "title": "Load averages (1m / 5m / 15m)",
      "description": "Per-host load averages. 1m > 5m > 15m = load is rising. 1m < 5m < 15m = load is falling.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 15},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 2, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 5}}, "overrides": [
        {"matcher": {"id": "byRegexp", "options": "1m.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#5794F2"}}]},
        {"matcher": {"id": "byRegexp", "options": "5m.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#FF9830"}}]},
        {"matcher": {"id": "byRegexp", "options": "15m.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#E02F44"}}]}
      ]},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "A", "expr": "max by (host_name) (system_cpu_load_average_1m{host_name=~\"${host:regex}\"})", "legendFormat": "1m · {{host_name}}"},
        {"refId": "B", "expr": "max by (host_name) (system_cpu_load_average_5m{host_name=~\"${host:regex}\"})", "legendFormat": "5m · {{host_name}}"},
        {"refId": "C", "expr": "max by (host_name) (system_cpu_load_average_15m{host_name=~\"${host:regex}\"})", "legendFormat": "15m · {{host_name}}"}
      ]
    },

    {"id": 300, "type": "row", "title": "Memory & paging", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 24}},

    {"id": 20, "type": "timeseries", "title": "Memory by state (stacked)",
      "description": "used / cached / buffered / free / slab. Steady-state cached + buffered is healthy (Linux fills RAM with disk cache).",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 25},
      "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"drawStyle": "line", "lineWidth": 0, "fillOpacity": 80, "stacking": {"mode": "normal", "group": "A"}}}, "overrides": [
        {"matcher": {"id": "byName", "options": "used"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#E02F44"}}]},
        {"matcher": {"id": "byName", "options": "cached"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#5794F2"}}]},
        {"matcher": {"id": "byName", "options": "buffered"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#73BF69"}}]},
        {"matcher": {"id": "byName", "options": "free"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#37872D"}}]},
        {"matcher": {"id": "byName", "options": "slab_reclaimable"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#B877D9"}}]},
        {"matcher": {"id": "byName", "options": "slab_unreclaimable"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#FA6400"}}]}
      ]},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (state) (system_memory_usage_bytes{host_name=~\"${host:regex}\"})", "legendFormat": "{{state}}"}]
    },
    {"id": 21, "type": "timeseries", "title": "Memory used % per host",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 25},
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 2, "min": 0, "max": 1, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.7}, {"color": "orange", "value": 0.85}, {"color": "red", "value": 0.95}]}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 25, "thresholdsStyle": {"mode": "dashed"}}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "max by (host_name) (system_memory_utilization_ratio{host_name=~\"${host:regex}\", state=\"used\"})", "legendFormat": "{{host_name}}"}]
    },
    {"id": 22, "type": "timeseries", "title": "Page faults / sec",
      "description": "Major faults = disk-backed (slow). Minor = in-memory (fast). Sudden spikes in major = memory pressure causing swap-in.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 34},
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15}}, "overrides": [
        {"matcher": {"id": "byName", "options": "major"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#E02F44"}}]},
        {"matcher": {"id": "byName", "options": "minor"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#5794F2"}}]}
      ]},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (type) (rate(system_paging_faults_total{host_name=~\"${host:regex}\"}[$__rate_interval]))", "legendFormat": "{{type}}"}]
    },
    {"id": 23, "type": "timeseries", "title": "Swap utilization",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 34},
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 3, "min": 0, "max": 1, "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [{"refId": "A", "expr": "max by (host_name) (system_swap_utilization_ratio{host_name=~\"${host:regex}\"})", "legendFormat": "{{host_name}}"}]
    },
    {"id": 24, "type": "timeseries", "title": "Paging operations / sec",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 34},
      "fieldConfig": {"defaults": {"unit": "ops", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [{"refId": "A", "expr": "sum by (host_name) (rate(system_paging_operations_total{host_name=~\"${host:regex}\"}[$__rate_interval]))", "legendFormat": "{{host_name}}"}]
    },

    {"id": 400, "type": "row", "title": "Disk I/O", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 42}},

    {"id": 30, "type": "timeseries", "title": "Disk throughput (read / write) per host",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 43},
      "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15}}, "overrides": [
        {"matcher": {"id": "byRegexp", "options": "read.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#5794F2"}}]},
        {"matcher": {"id": "byRegexp", "options": "write.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#FF9830"}}]}
      ]},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (host_name, direction) (rate(system_disk_io_bytes_total{host_name=~\"${host:regex}\"}[$__rate_interval]))", "legendFormat": "{{direction}} · {{host_name}}"}]
    },
    {"id": 31, "type": "timeseries", "title": "Disk IOPS (operations / sec)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 43},
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15}}, "overrides": [
        {"matcher": {"id": "byRegexp", "options": "read.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#5794F2"}}]},
        {"matcher": {"id": "byRegexp", "options": "write.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#FF9830"}}]}
      ]},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (host_name, direction) (rate(system_disk_operations_total{host_name=~\"${host:regex}\"}[$__rate_interval]))", "legendFormat": "{{direction}} · {{host_name}}"}]
    },
    {"id": 32, "type": "timeseries", "title": "Disk pending operations (queue depth)",
      "description": "Sustained high queue = disk is the bottleneck.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 52},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [{"refId": "A", "expr": "sum by (host_name, device) (system_disk_pending_operations{host_name=~\"${host:regex}\"})", "legendFormat": "{{device}} · {{host_name}}"}]
    },
    {"id": 33, "type": "timeseries", "title": "Disk weighted I/O time / sec",
      "description": "system_disk_weighted_io_time. Saturation indicator — higher = busier disk.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 52},
      "fieldConfig": {"defaults": {"unit": "s", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [{"refId": "A", "expr": "sum by (host_name, device) (rate(system_disk_weighted_io_time_seconds_total{host_name=~\"${host:regex}\"}[$__rate_interval]))", "legendFormat": "{{device}} · {{host_name}}"}]
    },

    {"id": 500, "type": "row", "title": "Filesystem", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 60}},

    {"id": 40, "type": "table", "title": "Filesystem usage by mountpoint",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 61},
      "fieldConfig": {"defaults": {"custom": {"align": "auto"}}, "overrides": [
        {"matcher": {"id": "byName", "options": "Used"}, "properties": [{"id": "unit", "value": "bytes"}, {"id": "decimals", "value": 1}]},
        {"matcher": {"id": "byName", "options": "Free"}, "properties": [{"id": "unit", "value": "bytes"}, {"id": "decimals", "value": 1}]},
        {"matcher": {"id": "byName", "options": "Used %"}, "properties": [{"id": "unit", "value": "percentunit"}, {"id": "decimals", "value": 2}, {"id": "custom.cellOptions", "value": {"type": "gauge", "mode": "gradient"}}, {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.7}, {"color": "orange", "value": 0.85}, {"color": "red", "value": 0.95}]}}]},
        {"matcher": {"id": "byName", "options": "Inodes used %"}, "properties": [{"id": "unit", "value": "percentunit"}, {"id": "decimals", "value": 2}, {"id": "custom.cellOptions", "value": {"type": "color-background", "mode": "gradient"}}, {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.7}, {"color": "red", "value": 0.9}]}}]}
      ]},
      "options": {"showHeader": true, "footer": {"show": false}, "sortBy": [{"displayName": "Used %", "desc": true}]},
      "targets": [
        {"refId": "A", "expr": "sum by (host_name, mountpoint, type) (system_filesystem_usage_bytes{host_name=~\"${host:regex}\", state=\"used\"})", "format": "table", "instant": true, "legendFormat": "__auto"},
        {"refId": "B", "expr": "sum by (host_name, mountpoint) (system_filesystem_usage_bytes{host_name=~\"${host:regex}\", state=\"free\"})", "format": "table", "instant": true, "legendFormat": "__auto"},
        {"refId": "C", "expr": "sum by (host_name, mountpoint) (system_filesystem_usage_bytes{host_name=~\"${host:regex}\", state=\"used\"}) / clamp_min(sum by (host_name, mountpoint) (system_filesystem_usage_bytes{host_name=~\"${host:regex}\", state=~\"used|free\"}), 1)", "format": "table", "instant": true, "legendFormat": "__auto"},
        {"refId": "D", "expr": "sum by (host_name, mountpoint) (system_filesystem_inodes_usage{host_name=~\"${host:regex}\", state=\"used\"}) / clamp_min(sum by (host_name, mountpoint) (system_filesystem_inodes_usage{host_name=~\"${host:regex}\", state=~\"used|free\"}), 1)", "format": "table", "instant": true, "legendFormat": "__auto"}
      ],
      "transformations": [
        {"id": "merge", "options": {}},
        {"id": "organize", "options": {
          "excludeByName": {"Time": true, "__name__": true, "job": true, "instance": true},
          "indexByName": {"host_name": 0, "mountpoint": 1, "type": 2, "Value #A": 3, "Value #B": 4, "Value #C": 5, "Value #D": 6},
          "renameByName": {"host_name": "Host", "mountpoint": "Mount", "type": "FS", "Value #A": "Used", "Value #B": "Free", "Value #C": "Used %", "Value #D": "Inodes used %"}
        }}
      ]
    },

    {"id": 600, "type": "row", "title": "Network", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 70}},

    {"id": 50, "type": "timeseries", "title": "Network throughput (rx / tx) per host",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 71},
      "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15}}, "overrides": [
        {"matcher": {"id": "byRegexp", "options": "receive.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#5794F2"}}]},
        {"matcher": {"id": "byRegexp", "options": "transmit.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#FF9830"}}]}
      ]},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (host_name, direction) (rate(system_network_io_bytes_total{host_name=~\"${host:regex}\"}[$__rate_interval]))", "legendFormat": "{{direction}} · {{host_name}}"}]
    },
    {"id": 51, "type": "timeseries", "title": "Network packet rate",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 71},
      "fieldConfig": {"defaults": {"unit": "pps", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (host_name, direction) (rate(system_network_packets_total{host_name=~\"${host:regex}\"}[$__rate_interval]))", "legendFormat": "{{direction}} · {{host_name}}"}]
    },
    {"id": 52, "type": "timeseries", "title": "Network errors & dropped packets / sec",
      "description": "Both should be near zero in healthy networks. Sustained > 0 = NIC issue, link saturation, or kernel buffer exhaustion.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 80},
      "fieldConfig": {"defaults": {"unit": "ops", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.1}, {"color": "red", "value": 1}]}, "custom": {"drawStyle": "bars", "lineWidth": 0, "fillOpacity": 70}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["sum", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "A", "expr": "sum by (host_name) (rate(system_network_errors_total{host_name=~\"${host:regex}\"}[$__rate_interval]))", "legendFormat": "errors · {{host_name}}"},
        {"refId": "B", "expr": "sum by (host_name) (rate(system_network_dropped_total{host_name=~\"${host:regex}\"}[$__rate_interval]))", "legendFormat": "dropped · {{host_name}}"}
      ]
    },
    {"id": 53, "type": "timeseries", "title": "Active network connections",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 80},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (host_name, state) (system_network_connections{host_name=~\"${host:regex}\"})", "legendFormat": "{{state}} · {{host_name}}"}]
    },

    {"id": 700, "type": "row", "title": "Processes & threads", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 88}},

    {"id": 60, "type": "timeseries", "title": "Process count per host",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 89},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [{"refId": "A", "expr": "sum by (host_name, status) (system_processes_count{host_name=~\"${host:regex}\"})", "legendFormat": "{{status}} · {{host_name}}"}]
    },
    {"id": 61, "type": "timeseries", "title": "Process creation rate",
      "description": "system_processes_created. High rates indicate fork-heavy workload.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 89},
      "fieldConfig": {"defaults": {"unit": "ops", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [{"refId": "A", "expr": "sum by (host_name) (rate(system_processes_created_total{host_name=~\"${host:regex}\"}[$__rate_interval]))", "legendFormat": "{{host_name}}"}]
    },
    {"id": 62, "type": "timeseries", "title": "Thread count per host",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 89},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [{"refId": "A", "expr": "sum by (host_name) (system_thread_count{host_name=~\"${host:regex}\"})", "legendFormat": "{{host_name}}"}]
    }
  ]
}
